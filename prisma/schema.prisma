// ==================== CONTRACTOR CONTRACTS / DIGITAL SIGNING ====================

// ContractorContract - Service agreement sent to customers for signing
model ContractorContract {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  jobId        String? @db.Uuid // optional link to a job

  // Contract identity
  contractNumber String @unique // CTR-2025-001
  title          String
  type           String @default("service_agreement") // service_agreement, change_order, proposal, scope_of_work, warranty, other

  // Content (rich text / markdown body or plain text template)
  body String @db.Text

  // Customer / recipient
  customerName  String
  customerEmail String
  customerPhone String?

  // Contractor details (snapshot at send time)
  contractorName  String
  contractorEmail String
  contractorPhone String?

  // Financial
  contractAmount Decimal? @db.Decimal(12, 2)
  depositAmount  Decimal? @db.Decimal(12, 2)
  paymentTerms   String?

  // Signing
  token      String?   @unique // public signing token
  status     String    @default("draft") // draft, sent, viewed, signed, declined, expired, void
  sentAt     DateTime? @db.Timestamp(6)
  viewedAt   DateTime? @db.Timestamp(6)
  signedAt   DateTime? @db.Timestamp(6)
  declinedAt DateTime? @db.Timestamp(6)
  expiresAt  DateTime? @db.Timestamp(6)

  // Customer signature (base64 data URL stored inline, or URL if uploaded)
  customerSignatureDataUrl String? @db.Text
  customerSignedIp         String?
  customerSignedUserAgent  String?
  customerSignedName       String? // name they typed when signing

  // Contractor countersignature
  contractorSignatureDataUrl String?   @db.Text
  contractorSignedAt         DateTime? @db.Timestamp(6)
  contractorSignedIp         String?
  contractorSignedUserAgent  String?

  // Signed PDFs
  signedPdfUrl      String? // unsigned PDF reference
  customerSignedPdfUrl String? // PDF after customer signature
  executedPdfUrl    String? // final PDF with both signatures + audit trail

  // Document integrity
  documentHash String? // SHA-256 hash of executed PDF

  // Decline reason
  declineReason String?

  // Notes
  notes String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  job        ContractorJob?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  events     ContractorContractEvent[]

  @@index([contractorId])
  @@index([jobId])
  @@index([status])
  @@index([token])
  @@index([customerEmail])
  @@index([contractNumber])
}

// ContractorContractEvent - Immutable audit trail for contract lifecycle
model ContractorContractEvent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String @db.Uuid

