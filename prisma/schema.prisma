  counterpartyType    String?  @db.VarChar(50) // bank_account, financial_account
  metadata            Json?    @db.JsonB
  createdAt           DateTime @default(now()) @db.Timestamp(6)

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============= STRIPE ISSUING (DEBIT CARDS) =============

// IssuingCardholder - per-user Stripe Issuing cardholder. Lives on the
// user's CONNECTED account (not platform), so cards spend from that
// user's Treasury balance and never touch our platform balance.
model IssuingCardholder {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String   @db.Uuid
  landlordId               String?  @db.Uuid
  contractorProfileId      String?  @db.Uuid
  stripeConnectedAccountId String   @db.VarChar(255)
  stripeCardholderId       String   @unique @db.VarChar(255)
  status                   String   @default("active") @db.VarChar(40)
  createdAt                DateTime @default(now()) @db.Timestamp(6)
  updatedAt                DateTime @updatedAt

  cards IssuingCard[]

  @@index([userId])
  @@index([stripeCardholderId])
}

// IssuingCard - one row per issued card (a user can have virtual + physical)
model IssuingCard {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardholderId             String   @db.Uuid
  userId                   String   @db.Uuid
  landlordId               String?  @db.Uuid
  contractorProfileId      String?  @db.Uuid
  financialAccountId       String   @db.Uuid
  stripeConnectedAccountId String   @db.VarChar(255)
  stripeCardId             String   @unique @db.VarChar(255)
  type                     String   @db.VarChar(20) // virtual | physical
  status                   String   @db.VarChar(20) // active | inactive | canceled
  frozen                   Boolean  @default(false)
  last4                    String?  @db.VarChar(4)
  brand                    String?  @db.VarChar(20)
  expMonth                 Int?
  expYear                  Int?
  monthlyLimitCents        BigInt?
  blockedCategories        String[] @default([])
  shippingStatus           String?  @db.VarChar(40)
  shippingTrackingNumber   String?  @db.VarChar(255)
  shippingCarrier          String?  @db.VarChar(40)
  createdAt                DateTime @default(now()) @db.Timestamp(6)
  updatedAt                DateTime @updatedAt

  cardholder     IssuingCardholder      @relation(fields: [cardholderId], references: [id], onDelete: Cascade)
  authorizations IssuingAuthorization[]
  transactions   IssuingTransaction[]

  @@index([userId])
  @@index([stripeCardId])
  @@index([status])
  @@index([financialAccountId])
}

model IssuingAuthorization {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId           String   @db.Uuid
  userId           String   @db.Uuid
  stripeAuthId     String   @unique @db.VarChar(255)
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("usd") @db.VarChar(3)
  approved         Boolean
  merchantName     String?  @db.VarChar(255)
  merchantCategory String?  @db.VarChar(80)
  merchantCity     String?  @db.VarChar(80)
  merchantState    String?  @db.VarChar(40)
  merchantCountry  String?  @db.VarChar(4)
  declineReason    String?  @db.VarChar(80)
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  card IssuingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([createdAt])
}

model IssuingTransaction {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId              String   @db.Uuid
  userId              String   @db.Uuid
  stripeTransactionId String   @unique @db.VarChar(255)
  stripeAuthId        String?  @db.VarChar(255)
  amount              Decimal  @db.Decimal(12, 2)
  currency            String   @default("usd") @db.VarChar(3)
  type                String   @db.VarChar(40)
  merchantName        String?  @db.VarChar(255)
  merchantCategory    String?  @db.VarChar(80)
  createdAt           DateTime @default(now()) @db.Timestamp(6)

  card IssuingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([createdAt])
}

// ============= CONTRACTOR MARKETPLACE =============

// ContractorProfile - Public marketplace profile for contractors
model ContractorProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  slug   String @unique // contractor-name-123 for URL

  // Basic Info
  businessName String
  displayName  String
  tagline      String? // Short description like "Licensed Plumber - 15 Years Experience"
  bio          String?
  profilePhoto String?
  coverPhoto   String?

  // Contact & Location
  email         String
  phone         String?
  website       String?
  serviceAreas  String[] @default([]) // zip codes or city names
  serviceRadius Int? // miles from base location
  baseCity      String?
  baseState     String?

  // Professional Info
  specialties       String[]  @default([]) // plumbing, electrical, HVAC, etc.
  yearsExperience   Int?
  licenseNumber     String?
  licenseState      String?
  insuranceVerified Boolean   @default(false)
  insuranceExpiry   DateTime? @db.Timestamp(6)
  backgroundChecked Boolean   @default(false)

  // Portfolio
  portfolioImages String[] @default([])
  portfolioVideos String[] @default([])

  // Availability
  isAvailable       Boolean @default(true)
  availabilityNotes String?

  // Marketplace Settings
  isPublic         Boolean  @default(true) // visible in marketplace
  acceptingNewWork Boolean  @default(true)
  minimumJobSize   Decimal? @db.Decimal(12, 2)
  hourlyRate       Decimal? @db.Decimal(10, 2)

  // Computed/Cached Stats (updated by ranking job)
  rankScore        Float @default(0) // 0-100 composite score
  avgRating        Float @default(0) // 1-5 stars
  totalReviews     Int   @default(0)
  completedJobs    Int   @default(0)
  responseRate     Float @default(0) // % of messages responded to
  onTimeRate       Float @default(0) // % completed on schedule
  repeatClientRate Float @default(0) // % of clients who hire again

  // Verification
