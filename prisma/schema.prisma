// ContractorVerification - Tracks verification status and documents
model ContractorVerification {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @unique @db.Uuid

  // Overall Status
  verificationStatus String    @default("unverified") // unverified, pending, verified, rejected
  verifiedAt         DateTime? @db.Timestamp(6)

  // Identity Verification
  identityStatus          String    @default("not_started") // not_started, pending, verified, rejected
  identityProvider        String? // persona, stripe_identity, manual
  identityVerificationId  String? // External provider ID
  identityVerifiedAt      DateTime? @db.Timestamp(6)
  identityDocumentType    String? // drivers_license, passport, etc
  identityDocumentUrl     String?
  identityRejectionReason String?

  // Business License Verification
  licenseStatus           String    @default("not_started")
  licenseNumber           String?
  licenseState            String?
  licenseType             String? // general_contractor, plumber, electrician, etc
  licenseDocumentUrl      String?
  licenseVerifiedAt       DateTime? @db.Timestamp(6)
  licenseExpiresAt        DateTime? @db.Timestamp(6)
  licenseVerificationData Json?     @db.Json
  licenseRejectionReason  String?

  // Insurance Verification
  insuranceStatus          String    @default("not_started")
  insuranceProvider        String?
  insurancePolicyNumber    String?
  insuranceCoverageAmount  Decimal?  @db.Decimal(12, 2)
  insuranceCertificateUrl  String?
  insuranceVerifiedAt      DateTime? @db.Timestamp(6)
  insuranceExpiresAt       DateTime? @db.Timestamp(6)
  insuranceRejectionReason String?

  // Background Check
  backgroundCheckStatus          String    @default("not_started")
  backgroundCheckProvider        String? // checkr, sterling, manual
  backgroundCheckId              String? // External provider ID
  backgroundCheckDate            DateTime? @db.Timestamp(6)
  backgroundCheckExpires         DateTime? @db.Timestamp(6)
  backgroundCheckResult          String? // clear, consider, suspended
  backgroundCheckData            Json?     @db.Json
  backgroundCheckRejectionReason String?

  // Tax Information
  taxIdStatus          String    @default("not_started")
  taxIdType            String? // ein, ssn
  taxIdLast4           String? // Last 4 digits only
  taxIdVerifiedAt      DateTime? @db.Timestamp(6)
  taxIdRejectionReason String?

  // Bank Account Verification (for payouts)
  bankAccountStatus     String    @default("not_started")
  bankAccountVerified   Boolean   @default(false)
  bankAccountVerifiedAt DateTime? @db.Timestamp(6)
  stripeAccountId       String?

  // Admin Review
  reviewedBy  String?   @db.Uuid // Admin user ID
  reviewedAt  DateTime? @db.Timestamp(6)
  reviewNotes String?

  // Verification Badges
  badges String[] @default([]) // verified, licensed, insured, background_checked, top_rated

  // Timestamps
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  // Relations
  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("VerificationReviewer", fields: [reviewedBy], references: [id])

  @@index([contractorId])
  @@index([verificationStatus])
  @@index([identityStatus])
  @@index([licenseStatus])
  @@index([insuranceStatus])
  @@index([backgroundCheckStatus])
}

