  @@index([companyName])
  @@index([userId])
}

// Job seeker profiles - people looking for work in the industry
model JobSeekerProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @db.Uuid
  headline          String // "Experienced Property Manager" or "Licensed Electrician"
