// ContractorSubcontractor - Dedicated subcontractor management
model ContractorSubcontractor {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid // The general contractor

  // Business info
  companyName     String
  contactName     String
  email           String
  phone           String?
  licenseNumber   String?
  licenseState    String?
  insuranceExpiry DateTime? @db.Timestamp(6)
  taxId           String? // EIN for 1099

  // Specialties
  specialties String[] @default([])
  rating      Decimal? @db.Decimal(3, 2)

  // Status
  status String @default("active") // active, inactive, blacklisted

  // Financial terms
  paymentTerms     String @default("net_30") // net_15, net_30, net_45, due_on_receipt
  preferredPayment String @default("check") // check, ach, wire

  // Bank info (for ACH payments)
  bankAccountName   String?
  bankAccountNumber String? // Encrypted
  bankRoutingNumber String? // Encrypted
  bankName          String?

  // Documents
  insuranceCertificate String?
  w9Form               String?
  contracts            String[] @default([])

  // Relations
  assignments ContractorSubcontractorAssignment[]
  pos         ContractorPurchaseOrder[]           @relation("SubcontractorPO")
  payments    ContractorSubcontractorPayment[]

  notes String?

