  platformFee      Decimal?  @db.Decimal(10, 2) // Platform cut on release

  // Completion
  completedAt         DateTime? @db.Timestamp(6)
  customerConfirmedAt DateTime? @db.Timestamp(6) // Customer confirmed job done
  disputeReason       String?
  disputeFiledAt      DateTime? @db.Timestamp(6)

  // Job linkage
  jobId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([customerId])
  @@index([startTime])
  @@index([status])
  @@index([escrowStatus])
  @@index([autoReleaseAt])
}

// ContractorInvoice - Invoices created by contractors for their customers
