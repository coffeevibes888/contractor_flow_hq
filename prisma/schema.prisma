  @@unique([contractorId, email])
  @@index([contractorId])
  @@index([status])
  @@index([email])
}

// ContractorSubcontractorAssignment - Assign subs to jobs
model ContractorSubcontractorAssignment {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId    String @db.Uuid
  subcontractorId String @db.Uuid
  jobId           String @db.Uuid

  // Assignment details
  scopeOfWork    String
  agreedPrice    Decimal @db.Decimal(12, 2)
  estimatedHours Int?

  // Schedule
  startDate DateTime? @db.Timestamp(6)
  endDate   DateTime? @db.Timestamp(6)

  // Status
  status String @default("assigned") // assigned, in_progress, completed, canceled

  // Payment terms (overrides whatever's set on the subcontractor record)
  paymentTerms  String @default("net_30") // net_15, net_30, net_45, net_60, net_90, due_on_receipt
  paymentMethod String @default("check") // check, ach, wire, zelle, cash, wallet

  // Completion
