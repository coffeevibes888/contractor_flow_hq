  attachments String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  job        ContractorJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([jobId])
  @@index([createdAt])
}

// ContractorMarketingCampaign - Email/SMS marketing campaigns (Business tier)
model ContractorMarketingCampaign {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid

  // Campaign details
  name   String
  type   String // email, sms, both
  status String @default("draft") // draft, scheduled, sending, sent, paused

  // Content
  subject    String? // For email
  message    String
  templateId String?

  // Targeting
  targetAudience String // all_customers, repeat_customers, inactive_customers, custom
  customerIds    String[] @default([]) // For custom targeting

  // Scheduling
  scheduledFor DateTime? @db.Timestamp(6)
  sentAt       DateTime? @db.Timestamp(6)

