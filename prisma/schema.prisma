// MILESTONE ESCROW SYSTEM (Phase 8.2)
// ============================================

// JobEscrow - Main escrow account for milestone-based payments
model JobEscrow {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorJobId  String    @unique @db.Uuid
  totalAmount      Decimal   @db.Decimal(12, 2)
  platformFee      Decimal   @db.Decimal(12, 2)
  contractorAmount Decimal   @db.Decimal(12, 2)
  status           String    @default("pending") // pending, funded, partial, released, refunded, disputed
  stripePaymentId  String?
  fundedAt         DateTime? @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt

  contractorJob ContractorJob   @relation(fields: [contractorJobId], references: [id], onDelete: Cascade)
  milestones    JobMilestone[]
  releases      EscrowRelease[]
  disputes      EscrowDispute[]

  @@index([contractorJobId])
  @@index([status])
  @@index([fundedAt])
}

// JobMilestone - Individual payment milestones with verification requirements
model JobMilestone {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escrowId    String  @db.Uuid
  order       Int // Milestone sequence number
  title       String
  description String?
  amount      Decimal @db.Decimal(12, 2)
  percentage  Int // Percentage of total job amount
  status      String  @default("pending") // pending, in_progress, completed, released, disputed

  // Verification requirements
  requireGPS       Boolean @default(false)
  requirePhotos    Boolean @default(false)
  minPhotos        Int     @default(0)
  requireSignature Boolean @default(false)

  // GPS Verification data
  gpsVerified   Boolean   @default(false)
  gpsLat        Float?
  gpsLng        Float?
  gpsAddress    String?
  gpsVerifiedAt DateTime? @db.Timestamp(6)

  // Photo verification data
  photosUploaded Int      @default(0)
  photoUrls      String[] @default([])
  photoPublicIds String[] @default([])

  // Digital signatures
  contractorSigned    Boolean   @default(false)
  contractorSignedAt  DateTime? @db.Timestamp(6)
  contractorSignature String? // Base64 image or URL

  customerSigned    Boolean   @default(false)
  customerSignedAt  DateTime? @db.Timestamp(6)
  customerSignature String? // Base64 image or URL

  // Completion tracking
  completedAt   DateTime? @db.Timestamp(6)
  releasedAt    DateTime? @db.Timestamp(6)
  autoReleaseAt DateTime? @db.Timestamp(6) // Auto-release after 7 days

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  escrow   JobEscrow       @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  releases EscrowRelease[]

  @@index([escrowId])
  @@index([status])
  @@index([order])
  @@index([autoReleaseAt])
}

// EscrowRelease - Track fund releases from escrow to contractor
model EscrowRelease {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escrowId         String    @db.Uuid
  milestoneId      String?   @db.Uuid
  amount           Decimal   @db.Decimal(12, 2)
  platformFee      Decimal   @db.Decimal(12, 2)
  contractorAmount Decimal   @db.Decimal(12, 2)
  releaseType      String // milestone, bonus, refund, dispute_resolution, early_release
  stripeTransferId String?
  status           String    @default("pending") // pending, processing, completed, failed
  releasedBy       String?   @db.Uuid // userId who approved release
  releasedAt       DateTime? @db.Timestamp(6)
  completedAt      DateTime? @db.Timestamp(6)
  failureReason    String?
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt

  escrow    JobEscrow     @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  milestone JobMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([escrowId])
  @@index([milestoneId])
  @@index([status])
  @@index([releaseType])
  @@index([releasedAt])
}

// EscrowDispute - Handle payment disputes between customer and contractor
model EscrowDispute {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escrowId          String    @db.Uuid
  milestoneId       String?   @db.Uuid
  filedBy           String    @db.Uuid // userId who filed dispute
  filedByRole       String // customer, contractor
  reason            String // not_completed, poor_quality, wrong_work, other
  description       String
  requestedAmount   Decimal   @db.Decimal(12, 2)
  evidenceUrls      String[]  @default([])
  evidencePublicIds String[]  @default([])
  status            String    @default("open") // open, under_review, resolved, closed
  resolution        String? // full_refund, partial_refund, release_to_contractor, split_payment
  resolutionNotes   String?
  resolvedBy        String?   @db.Uuid // admin userId
  resolvedAt        DateTime? @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt

  escrow JobEscrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([milestoneId])
  @@index([filedBy])
  @@index([status])
  @@index([createdAt])
}

// MilestoneTemplate - Pre-built milestone structures for quick setup
model MilestoneTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String
  category    String // standard, progressive, detailed, custom
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  structure   Json // Array of {title, percentage, requireGPS, requirePhotos, minPhotos, requireSignature}
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isDefault])
  @@index([isActive])
}

// ==================== NEW CONTRACTOR FEATURES ====================

// ContractorPurchaseOrder - Formal purchase order tracking for materials
model ContractorPurchaseOrder {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid

  // PO Details
  poNumber String  @unique // PO-2024-0001
  status   String  @default("draft") // draft, sent, acknowledged, partially_received, received, canceled
  vendorId String? @db.Uuid // Link to ContractorVendor

  // Job reference
  jobId String? @db.Uuid // Optional - PO can be for general inventory or specific job

  // Subcontractor reference (for POs to subs)
  subcontractorId String? @db.Uuid

  // Financial
  subtotal Decimal  @db.Decimal(12, 2)
  tax      Decimal  @db.Decimal(12, 2)
  shipping Decimal? @db.Decimal(12, 2)
  total    Decimal  @db.Decimal(12, 2)
  currency String   @default("USD")

  // Dates
  orderDate    DateTime  @default(now()) @db.Timestamp(6)
  requiredDate DateTime? @db.Timestamp(6)
  deliveryDate DateTime? @db.Timestamp(6)

  // Delivery
  deliveryAddress      String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZip          String?
  deliveryInstructions String?

  // Relations
  lineItems ContractorPurchaseOrderItem[]

  // Tracking
  notes         String?
  internalNotes String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor    ContractorProfile        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  vendor        ContractorVendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  job           ContractorJob?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  subcontractor ContractorSubcontractor? @relation("SubcontractorPO", fields: [subcontractorId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([status])
  @@index([vendorId])
  @@index([jobId])
  @@index([subcontractorId])
  @@index([orderDate])
}

// ContractorPurchaseOrderItem - Individual line items on a PO
model ContractorPurchaseOrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poId      String  @db.Uuid
  itemName  String
  sku       String?
  quantity  Decimal @db.Decimal(10, 2)
  unit      String // each, box, roll, sq_ft, etc.
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Receiving tracking
  quantityOrdered     Decimal @db.Decimal(10, 2)
  quantityReceived    Decimal @default(0) @db.Decimal(10, 2)
  quantityBackordered Decimal @default(0) @db.Decimal(10, 2)

  // Optional inventory link
  inventoryItemId String? @db.Uuid

  notes String?

  purchaseOrder ContractorPurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  inventoryItem ContractorInventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([poId])
  @@index([inventoryItemId])
}

// ContractorWarranty - Warranty and service agreement tracking
model ContractorWarranty {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid

  // Reference
  jobId      String? @db.Uuid // Optional - warranty can be standalone
  customerId String  @db.Uuid
  invoiceId  String? @db.Uuid

  // Warranty Details
  warrantyNumber String @unique // W-2024-0001
  warrantyType   String // workmanship, material, extended, manufacturer
