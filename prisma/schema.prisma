  eventType String // created, sent, viewed, signed, declined, expired, voided, countersigned, downloaded
  actor     String // "contractor" | "customer" | "system"
  actorName String?
  actorIp   String?
  note      String?

  createdAt DateTime @default(now()) @db.Timestamp(6)

  contract ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

