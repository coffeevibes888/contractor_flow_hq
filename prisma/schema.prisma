// ============= REAL ESTATE AGENTS =============

// Agent - Real estate agent profile
model Agent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @db.Uuid
  name             String
  subdomain        String    @unique
  licenseNumber    String?
  licenseState     String?
  licenseExpiry    DateTime? @db.Date
