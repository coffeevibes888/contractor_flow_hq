  job        ContractorJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([jobId])
  @@index([status])
}

// ContractorJobNote - Internal notes and updates on jobs
model ContractorJobNote {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid
  jobId        String @db.Uuid
  authorId     String @db.Uuid // Employee or contractor user

  // Note content
  content String
  type    String @default("general") // general, issue, update, customer_communication

