// ContractorLeadPreferences - Contractor's lead matching preferences
model ContractorLeadPreferences {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @unique @db.Uuid

  // Service preferences
