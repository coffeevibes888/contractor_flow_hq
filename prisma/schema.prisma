// ContractorWarrantyClaim - Individual warranty claims
model ContractorWarrantyClaim {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warrantyId   String @db.Uuid
  contractorId String @db.Uuid

  // Claim details
