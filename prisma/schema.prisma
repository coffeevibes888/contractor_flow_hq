// ContractorReferral - Track customer referrals
model ContractorReferral {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  referrerId   String  @db.Uuid // ContractorCustomer who referred
  referredId   String? @db.Uuid // ContractorCustomer who was referred

  // Referral details
  referredName  String
  referredEmail String?
  referredPhone String?

  // Status
  status String @default("pending") // pending, contacted, converted, lost

  // Conversion
  convertedAt DateTime? @db.Timestamp(6)
  jobValue    Decimal?  @db.Decimal(12, 2)

  // Reward
  rewardType   String? // discount, cash, gift_card
  rewardAmount Decimal? @db.Decimal(10, 2)
  rewardGiven  Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  referrer   ContractorCustomer  @relation("ReferrerCustomer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   ContractorCustomer? @relation("ReferredCustomer", fields: [referredId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([referrerId])
  @@index([status])
}

// ContractorBlockedDate - Block specific dates (vacations, holidays, etc)
model ContractorBlockedDate {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid

  startDate DateTime @db.Timestamp(6)
  endDate   DateTime @db.Timestamp(6)
  reason    String?
  isAllDay  Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamp(6)

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([startDate, endDate])
}

// ContractorServiceDuration - Set duration for each service type
model ContractorServiceDuration {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid

  serviceName String
  duration    Int // Duration in minutes
  description String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, serviceName])
  @@index([contractorId])
}

// ==================== QUOTE & OFFER SYSTEM ====================

// ContractorQuote - Quotes/Offers sent by contractors to customers
model ContractorQuote {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Reference
  leadId       String  @db.Uuid // from ContractorLead
  leadMatchId  String? @db.Uuid // from ContractorLeadMatch if applicable
  contractorId String  @db.Uuid
  customerId   String  @db.Uuid // customer user ID

  // Quote details
  title          String
  description    String?
  projectScope   String? // detailed scope of work
  deliverables   String[]  @default([]) // list of deliverables
  startDate      DateTime? @db.Timestamp(6)
  completionDate DateTime? @db.Timestamp(6)
  estimatedHours Decimal?  @db.Decimal(10, 2)
  hourlyRate     Decimal?  @db.Decimal(10, 2)

  // Pricing
  basePrice       Decimal  @db.Decimal(12, 2) // base price
  discount        Decimal  @default(0) @db.Decimal(10, 2) // discount amount
  discountPercent Decimal? @db.Decimal(5, 2) // discount percentage
  tax             Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(12, 2) // final price (basePrice - discount + tax)

  // Terms
  paymentTerms String? // net_30, upfront, milestone, etc
  warranty     String? // warranty info
  notes        String?
  attachments  String[] @default([]) // URLs to attached files/images

  // Validity
  validUntil DateTime @db.Timestamp(6) // quote expiration date
  status     String   @default("pending") // pending, viewed, accepted, rejected, expired, counterOffered

  // Counters (for multi-round negotiation)
  counterOfferCount  Int       @default(0)
  lastCounterOfferAt DateTime? @db.Timestamp(6)

  // Acceptance tracking
  acceptedAt      DateTime? @db.Timestamp(6)
  rejectedAt      DateTime? @db.Timestamp(6)
  rejectionReason String?

  // Create booking if accepted
  bookingCreatedAt DateTime? @db.Timestamp(6)
  bookingId        String?   @db.Uuid // WorkOrder ID if converted

  // Tracking
  viewedAt  DateTime? @db.Timestamp(6)
  viewCount Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  // Relations
  lead          ContractorLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadMatch     ContractorLeadMatch?     @relation(fields: [leadMatchId], references: [id], onDelete: SetNull)
  contractor    ContractorProfile        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer      User                     @relation("QuoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  counterOffers ContractorQuoteCounter[]
  messages      ContractorQuoteMessage[]

  @@index([leadId])
  @@index([contractorId])
  @@index([customerId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
}

// ContractorQuoteCounter - Counter offers for negotiation (like Fiverr/Upwork)
model ContractorQuoteCounter {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  originalQuoteId String @db.Uuid
  counterType     String // contractor_counter, customer_counter
  counterBy       String @db.Uuid // User ID of who made the counter

  // Updated terms
  basePrice    Decimal   @db.Decimal(12, 2)
  tax          Decimal   @default(0) @db.Decimal(10, 2)
  totalPrice   Decimal   @db.Decimal(12, 2)
  deliveryDate DateTime? @db.Timestamp(6)
  description  String?
  notes        String?

  // Status
  status     String    @default("pending") // pending, accepted, rejected, expired
  acceptedAt DateTime? @db.Timestamp(6)
  rejectedAt DateTime? @db.Timestamp(6)

  // Valid until
  validUntil DateTime @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  // Relations
  originalQuote ContractorQuote @relation(fields: [originalQuoteId], references: [id], onDelete: Cascade)
  initiatedBy   User            @relation("CounterOfferInitiator", fields: [counterBy], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?         @db.Uuid

  @@index([originalQuoteId])
  @@index([status])
  @@index([createdAt])
}

// ContractorQuoteMessage - Messages within quote/offer negotiation
model ContractorQuoteMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  quoteId String @db.Uuid
  fromId  String @db.Uuid
  toId    String @db.Uuid

  message     String
  attachments String[]  @default([])
  readAt      DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)

  // Relations
  quote ContractorQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  from  User            @relation("QuoteMessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to    User            @relation("QuoteMessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([fromId])
  @@index([toId])
  @@index([createdAt])
}

// ContractorBid - eBay-style bidding system
model ContractorBid {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Auction reference
  jobId        String @db.Uuid // WorkOrder ID or special job posting
  contractorId String @db.Uuid
  customerId   String @db.Uuid

  // Bid details
  bidAmount    Decimal  @db.Decimal(12, 2)
  bidMessage   String? // contractor's bid message/proposal
