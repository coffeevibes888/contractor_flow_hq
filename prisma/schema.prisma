// ─────────────────────────────────────────────────────────────────────────────
// Advanced Accounting — Phase 1: General Ledger
// Real double-entry bookkeeping so PropertyFlow can compete with Buildium,
// AppFolio, and Rentvine on actual accounting (not just rollup analytics).
//
//   ChartOfAccount  →  JournalEntry  →  JournalLine (debit/credit, balanced)
//
// Gated by subscription tier (Pro and Enterprise only). The existing
// `Expense` / `RentPayment` / `MaintenanceTicket.cost` tables remain the
// source of truth for the Starter tier's free-text-category rollup.
// ─────────────────────────────────────────────────────────────────────────────

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

model ChartOfAccount {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // null landlordId = system template account (seeded for all landlords)
  landlordId  String?     @db.Uuid
  code        String // "1100", "4100", "2110"
  name        String // "Cash - Operating", "Rental Income"
  type        AccountType
  subType     String? // current_asset, fixed_asset, current_liability, etc.
  parentId    String?     @db.Uuid
  isSystem    Boolean     @default(false) // true = can't be edited/deleted
  isActive    Boolean     @default(true)
  // IRS Schedule E line mapping for 1099 / tax export (e.g. "line_14", "line_16")
  taxLine     String?
  description String?
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)

  parent   ChartOfAccount?  @relation("AcctTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ChartOfAccount[] @relation("AcctTree")
  lines    JournalLine[]
  landlord Landlord?        @relation(fields: [landlordId], references: [id])

  @@unique([landlordId, code])
  @@index([landlordId, type])
  @@index([landlordId, isActive])
}

model FiscalPeriod {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId String    @db.Uuid
  startDate  DateTime  @db.Timestamp(6)
  endDate    DateTime  @db.Timestamp(6)
  // open → entries can post; locked → no new entries (admin can override); closed → permanent
  status     String    @default("open")
  closedAt   DateTime? @db.Timestamp(6)
  closedBy   String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamp(6)

  entries  JournalEntry[]
  landlord Landlord       @relation(fields: [landlordId], references: [id])

  @@unique([landlordId, startDate])
  @@index([landlordId, status])
}

model JournalEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId    String   @db.Uuid
  periodId      String?  @db.Uuid
  postedAt      DateTime @default(now()) @db.Timestamp(6)
  effectiveDate DateTime @db.Timestamp(6)
  memo          String?
  // rent_payment | expense | maintenance | owner_distribution | owner_payout |
  // opening_balance | manual_adjustment | system | tenant_credit
  source        String
  // Polymorphic ref back to the source record (RentPayment.id, Expense.id, etc.)
  sourceId      String?
  isReversing   Boolean  @default(false)
  reversedById  String?  @db.Uuid
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  period          FiscalPeriod?    @relation(fields: [periodId], references: [id], onDelete: SetNull)
  lines           JournalLine[]
  landlord        Landlord         @relation(fields: [landlordId], references: [id])
  bankTransaction BankTransaction?

  @@index([landlordId, effectiveDate])
  @@index([landlordId, postedAt])
  @@index([source, sourceId])
  @@index([periodId])
}

model JournalLine {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId    String   @db.Uuid
  accountId  String   @db.Uuid
  debit      Decimal  @default(0) @db.Decimal(14, 2)
  credit     Decimal  @default(0) @db.Decimal(14, 2)
  // Slicing dimensions — populated when known, null when the line is portfolio-level
  propertyId String?  @db.Uuid
  unitId     String?  @db.Uuid
  tenantId   String?  @db.Uuid
  ownerId    String?  @db.Uuid
  memo       String?
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  entry   JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([entryId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([ownerId])
}

model AccountingAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId String   @db.Uuid
  userId     String?  @db.Uuid
  // journal.post | journal.reverse | period.close | account.create | account.update |
  // statement.generate | statement.send | tenant_credit | system.backfill
  action     String
  entityType String // JournalEntry | ChartOfAccount | OwnerStatement | ...
  entityId   String   @db.Uuid
  changes    Json?    @db.Json
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  landlord   Landlord @relation(fields: [landlordId], references: [id])

  @@index([landlordId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Advanced Accounting — Phase 2: Tenant Ledger
// Per-tenant running balance. Posted automatically when rent is charged,
// when rent is paid, when late fees are assessed, and when credits are issued.
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerEntryType {
  charge
  payment
  late_fee
  credit
  refund
  adjustment
  deposit
  deposit_refund
}

model TenantLedgerEntry {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId     String          @db.Uuid
  tenantId       String          @db.Uuid
  leaseId        String          @db.Uuid
  propertyId     String          @db.Uuid
  unitId         String          @db.Uuid
  type           LedgerEntryType
  // Positive = charge / amount owed to landlord.
  // Negative = payment / credit reducing the balance.
  amount         Decimal         @db.Decimal(12, 2)
  // running balance after this entry posts (denormalized for fast reads)
  runningBalance Decimal         @db.Decimal(14, 2)
  effectiveDate  DateTime        @db.Timestamp(6)
  postedAt       DateTime        @default(now()) @db.Timestamp(6)
  description    String?
  // Link back to the source record and to the journal entry
  rentPaymentId  String?         @db.Uuid
  journalEntryId String?         @db.Uuid

  tenant      User         @relation("TenantLedgerTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  rentPayment RentPayment? @relation(fields: [rentPaymentId], references: [id])

  @@index([landlordId, postedAt])
  @@index([tenantId, postedAt])
  @@index([leaseId, postedAt])
  @@index([propertyId, postedAt])
  @@index([rentPaymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Advanced Accounting — Phase 2: Owners & Owner Statements
// A landlord can manage multiple owners (a property can be split between
// multiple owners via PropertyOwner). OwnerStatement is a monthly PDF
// generated for each owner showing income, expenses, fees, and distribution.
// ─────────────────────────────────────────────────────────────────────────────

model Owner {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId   String   @db.Uuid
  // optional portal login — if null, statements are sent to email only
  userId       String?  @db.Uuid
  name         String
  email        String?
  phone        String?
  // Encrypted at rest by the application layer (see lib/encrypt.ts)
  taxId        String?
  address      String?
  // ach | check | hold
  payoutMethod String   @default("ach")
  // % of net income that goes to this owner (default 100)
  payoutSplit  Decimal  @default(100.00) @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @db.Timestamp(6)

  properties    PropertyOwner[]
  statements    OwnerStatement[]
  distributions OwnerDistribution[]
  landlord      Landlord            @relation(fields: [landlordId], references: [id])

  @@index([landlordId, isActive])
  @@index([landlordId, email])
}

model PropertyOwner {
  propertyId    String   @db.Uuid
  ownerId       String   @db.Uuid
  // Owner's share of this specific property (0.0000 - 1.0000, four decimals)
  ownershipPct  Decimal  @default(100.00) @db.Decimal(5, 2)
  // Effective date for this ownership split — used for mid-year transfers
  effectiveFrom DateTime @default(now()) @db.Timestamp(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([propertyId, ownerId, effectiveFrom])
  @@index([ownerId])
}

model OwnerStatement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId       String    @db.Uuid
  ownerId          String    @db.Uuid
  periodStart      DateTime  @db.Timestamp(6)
  periodEnd        DateTime  @db.Timestamp(6)
  // The numbers below are stored at generation time so re-rendering
  // the PDF later doesn't drift if new entries are added.
  totalIncome      Decimal   @db.Decimal(14, 2)
  totalExpense     Decimal   @db.Decimal(14, 2)
  netIncome        Decimal   @db.Decimal(14, 2)
  managementFeePct Decimal   @db.Decimal(5, 2)
  managementFee    Decimal   @db.Decimal(14, 2)
  distribution     Decimal   @db.Decimal(14, 2)
  // draft → finalized (locked numbers) → sent (email went out)
  status           String    @default("draft")
  pdfUrl           String?
  emailSentAt      DateTime? @db.Timestamp(6)
  emailRecipients  String[]
  notes            String?
  generatedAt      DateTime  @default(now()) @db.Timestamp(6)
  generatedBy      String?   @db.Uuid
  finalizedAt      DateTime? @db.Timestamp(6)

  owner         Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  distributions OwnerDistribution[]
  landlord      Landlord            @relation(fields: [landlordId], references: [id])

  @@unique([ownerId, periodStart, periodEnd])
  @@index([landlordId, periodStart])
  @@index([status])
}

model OwnerDistribution {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String    @db.Uuid
  statementId      String?   @db.Uuid
  amount           Decimal   @db.Decimal(14, 2)
  // ach | check | hold
  method           String    @default("ach")
  // pending | processing | paid | failed | void
  status           String    @default("pending")
  scheduledFor     DateTime  @db.Timestamp(6)
  paidAt           DateTime? @db.Timestamp(6)
  // Stripe transfer id when paid via Stripe Connect
  stripeTransferId String?
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @db.Timestamp(6)

  owner     Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  statement OwnerStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([statementId])
  @@index([scheduledFor, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Advanced Accounting — Phase 3: Bank Reconciliation
// BankTransaction is one row per bank event (charge, refund, payout,
// outbound_transfer, inbound_transfer, application_fee, or a manually
// imported CSV row). We record the original Stripe object id (or a CSV
// fingerprint) so retries are idempotent. A transaction is "matched" when
// it pairs with a JournalEntry (or a domain record with a known GL impact).
// ─────────────────────────────────────────────────────────────────────────────

enum BankTransactionSource {
  stripe_charge // charge.succeeded / charge.refunded on landlord Connect account
  stripe_payout // payout.paid / payout.failed (Stripe → landlord bank)
  stripe_transfer // legacy Connect transfer (transfer.created/posted)
  stripe_outbound_xfer // Treasury outbound_transfer.posted/failed
  stripe_inbound_xfer // Treasury inbound_transfer.posted/failed
  stripe_application_fee // application_fee.created (platform fee leg)
  csv // manually imported CSV
}

enum BankTransactionStatus {
  unmatched // new, no GL match
  matched // auto or manual match to a journal entry
  ignored // PM marked as non-bookkeeping (e.g. inter-account move)
  needs_review // multiple GL candidates — PM must pick
}

model BankTransaction {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId               String                @db.Uuid
  // Optional FK to the landlord's Treasury FinancialAccount when the
  // transaction lives inside the wallet. Null for direct-debit bank rows
  // (rent from tenant ACH) and for CSV imports.
  financialAccountId       String?               @db.Uuid
  // stripe acct_xxx — which connected account this transaction is for.
  // We store it for debugging + per-account filtering in the UI.
  stripeConnectedAccountId String?               @db.VarChar(255)
  source                   BankTransactionSource
  // Stripe object id OR a CSV fingerprint hash. Unique per landlord so
  // webhooks can retry safely.
  externalId               String                @db.VarChar(255)
  // stripe_event.id for webhook-sourced rows, null for CSV.
  stripeEventId            String?               @db.VarChar(255)
  // Positive = money in (charge, inbound_transfer). Negative = money out
  // (payout, outbound_transfer, refund, fee). Always in dollars.
  amount                   Decimal               @db.Decimal(14, 2)
  currency                 String                @default("usd") @db.VarChar(3)
  description              String?
  // Raw Stripe object payload for audit / debugging. CSV imports get
  // { source: 'csv', originalRow: {...} } instead.
  rawPayload               Json?                 @db.Json
  // Money-movement date as the bank would report it. For Stripe events
  // this is event.created; for CSV it's whatever the user typed.
  postedAt                 DateTime              @db.Timestamp(6)
  // What we did with it.
  status                   BankTransactionStatus @default(unmatched)
  // Set when status = matched | ignored | needs_review.
  matchedJournalEntryId    String?               @unique @db.Uuid
  matchedAt                DateTime?             @db.Timestamp(6)
  matchedBy                String?               @db.Uuid
  // Free-form note from the PM ("inter-account transfer", "owner draw", etc.)
  notes                    String?
  createdAt                DateTime              @default(now()) @db.Timestamp(6)
  updatedAt                DateTime              @updatedAt

  financialAccount    FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  matchedJournalEntry JournalEntry?     @relation(fields: [matchedJournalEntryId], references: [id], onDelete: SetNull)
  landlord            Landlord          @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@unique([landlordId, externalId])
  @@index([landlordId, postedAt])
  @@index([landlordId, status])
  @@index([landlordId, source])
  @@index([stripeEventId])
}

// ============================================================================
// TENANT ONBOARDING SYSTEM
// ============================================================================

// Links tenants to landlords before property assignment
model TenantLandlordLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  landlordId  String    @db.Uuid
  
  // Tracking fields
  signupMethod String?   // 'email' | 'invite_code' | 'manual'
  inviteCode   String?   // The code they used (if applicable)
  status       String    @default("pending") // pending, assigned, archived
  
  // Assignment tracking
  assignedAt           DateTime? @db.Timestamp(6)
  assignedToPropertyId String?   @db.Uuid
  assignedToUnitId     String?   @db.Uuid
  
  // Auto-archive
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  archivedAt     DateTime? @db.Timestamp(6)
  archivedReason String?   // 'auto_30_day' | 'manual' | 'assigned'
  
  tenant   User      @relation("TenantLinks", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord Landlord  @relation("LandlordTenantLinks", fields: [landlordId], references: [id], onDelete: Cascade)
  property Property? @relation("TenantLinkProperty", fields: [assignedToPropertyId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation("TenantLinkUnit", fields: [assignedToUnitId], references: [id], onDelete: SetNull)
  
  @@unique([tenantId, landlordId])
  @@index([landlordId, status])
  @@index([status, createdAt])
}

// Landlord invite codes for tenant signup
model LandlordInviteCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  landlordId String    @db.Uuid
  code       String    @unique
  isActive   Boolean   @default(true)
  usageCount Int       @default(0)
  maxUses    Int?      // null = unlimited
  expiresAt  DateTime? @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)

  // Optional: pin this code to a specific property so the tenant lands there after sign-up
  propertyId String? @db.Uuid

  landlord Landlord  @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  property Property? @relation("InviteCodeProperty", fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([code, isActive])
  @@index([landlordId])
}

// Writing Studio — persisted state per super-admin user.
// One row per user; upserted on every auto-save.
model WritingStudioState {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @db.Uuid
  state       Json     @db.Json // the full ws_studio_v4 payload { items, activeId, notepads, activeNoteId }
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Free Lease Builder — Lead Capture ───────────────────────────────────────
// One row per email. Enriched with wizard data so superAdmin can see
// exactly who used the free tool and follow up for conversion.
model FreeLeaseUsage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique

  // Document type that was generated
  documentType    String?  @default("residential_lease") // e.g. residential_lease, commercial_nnn, eviction_notice, etc.

  // Lead identity
  landlordName    String?  // from wizard step 2
  ipAddress       String?

  // Property context (from wizard)
  state           String?  // e.g. "TX"
  propertyType    String?  // e.g. "apartment", "single_family"
  propertyAddress String?
  monthlyRent     Decimal? @db.Decimal(12, 2)

  // Attribution
  utmSource       String?  // utm_source query param at time of generation
  utmMedium       String?  // utm_medium query param
  utmCampaign     String?  // utm_campaign query param
  referrer        String?  // HTTP Referer header

  // Conversion tracking
  converted            Boolean  @default(false) // true once they sign up
  convertedAt          DateTime? @db.Timestamp(6)
  notes                String?  // superAdmin notes

  // Drip email tracking — keys: day3_features | day7_features
  // Written after a successful Resend send; prevents re-firing.
  leaseLeadEmailsSent  Json?

  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt

  @@index([email])
  @@index([converted])
  @@index([state])
  @@index([createdAt])
}

// Free Contract Builder usage tracking for contractor side.
// Same pattern as FreeLeaseUsage — one row per email for lead capture.
model FreeContractUsage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique

  // Lead identity
  contractorName  String?
  businessName    String?
  ipAddress       String?

  // Contract context (from wizard)
  tradeType       String?  // e.g. "general", "hvac", "plumbing"
  customerName    String?
  jobTitle        String?
  totalAmount     Decimal? @db.Decimal(12, 2)
  governingState  String?

  // Attribution
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  referrer        String?

  // Conversion tracking
  converted       Boolean  @default(false)
  convertedAt     DateTime? @db.Timestamp(6)
  notes           String?

  // Generated contract HTML (stored so they can download again)
  contractHtml    String?

  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt

  @@index([email])
  @@index([converted])
  @@index([tradeType])
  @@index([createdAt])
}

// ─── Email Event Tracking — Resend webhook sink ───────────────────────────────
// One row per event fired by Resend (email.sent, email.opened, email.clicked,
// email.bounced, email.complained, email.delivery_delayed).
// Populated by POST /api/webhooks/resend.
// resendEmailId is the Resend message ID (e.g. "re_xxxxxxxx").
// recipientEmail is denormalized for fast lookups without joining.
// emailType tags which lifecycle email this was (day1_explainer, day2_no_property, etc.)
model EmailEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resendEmailId  String                     // Resend message ID — not unique; multiple events per send
  recipientEmail String
  emailType      String?                    // day1_explainer | day2_no_property | day7_no_stripe | trial_reminder | free_lease_followup | etc.
  eventType      String                     // email.sent | email.opened | email.clicked | email.bounced | email.complained | email.delivery_delayed
  clickedUrl     String?                    // populated for email.clicked events
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  @@index([recipientEmail])
  @@index([resendEmailId])
  @@index([emailType])
  @@index([eventType, createdAt])
}

// ─── Public Lease E-Sign (standalone $4.99 funnel) ───────────────────────────
// One row per paid e-sign request from the free lease builder.
// Created when the Stripe checkout session completes.
// The landlord signs first (signatureDataUrl stored before checkout).
// Tenant(s) receive a unique token link to sign at /sign/lease/[token].
model PublicLeaseEsign {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token               String    @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '') || replace(gen_random_uuid()::text, '-', '')"))

  // The generated lease HTML (with placeholders for signatures)
  leaseHtml           String    @db.Text

  // Landlord info
  landlordName        String
  landlordEmail       String
  landlordSigDataUrl  String?   @db.Text  // base64 canvas PNG — captured before checkout

  // Tenant info (up to 2 tenants for now)
  tenantName1         String
  tenantEmail1        String
  tenantName2         String?
  tenantEmail2        String?

  // Signing state
  status              String    @default("pending_landlord_sig")
  // pending_landlord_sig → pending_payment → pending_tenant_sig → completed

  // Payment
  stripeSessionId     String?   @unique
  paidAt              DateTime? @db.Timestamp(6)

  // Tenant signing
  tenantSigDataUrl    String?   @db.Text  // base64 canvas PNG
  tenantSignedAt      DateTime? @db.Timestamp(6)
  tenantSignedByName  String?

  // Final document (signed HTML stored after both parties have signed)
  finalLeaseHtml      String?   @db.Text

  // Invite emails sent timestamp (so we can offer resend)
  invitesSentAt       DateTime? @db.Timestamp(6)

  // Link expiry — tenant token expires 14 days after invite sent
  expiresAt           DateTime? @db.Timestamp(6)

  // Attribution (carried over from the free lease flow)
  state               String?
  propertyAddress     String?
  utmSource           String?
  utmMedium           String?

  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @db.Timestamp(6)

  @@index([token])
  @@index([landlordEmail])
  @@index([tenantEmail1])
  @@index([status])
  @@index([stripeSessionId])
  @@index([createdAt])
}

