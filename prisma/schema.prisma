  status     String    @default("active") // active, withdrawn, accepted, rejected, expired
  acceptedAt DateTime? @db.Timestamp(6)
  rejectedAt DateTime? @db.Timestamp(6)

  // Auto-acceptance
  autoAccept  Boolean @default(false) // contractor accepts auto-acceptance terms
  acceptTerms String? // T&C json

  // Valid until
  validUntil DateTime @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  // Relations
  job        WorkOrder         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([jobId, contractorId])
  @@index([jobId])
  @@index([contractorId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
}

