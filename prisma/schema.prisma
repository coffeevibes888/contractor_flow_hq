  sessionId    String
  userId       String?  @db.Uuid
  path         String
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  country      String?
  region       String?
  city         String?
  device       String?
  browser      String?
  os           String?
  screenWidth  Int?
  screenHeight Int?
  timeOnPage   Int? // milliseconds
  scrollDepth  Int? // percentage 0-100
  exitPage     Boolean  @default(false)
  bounced      Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([path])
  @@index([createdAt])
  @@index([exitPage])
}

// ClickEvent - Click tracking for heatmap generation
model ClickEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String
  userId       String?  @db.Uuid
  path         String
  elementId    String?
  elementClass String?
  elementTag   String?
  elementText  String?
  xPosition    Int?
  yPosition    Int?
  timestamp    DateTime @default(now()) @db.Timestamp(6)

  @@index([sessionId])
  @@index([path])
  @@index([timestamp])
}

// UserSession - Complete user session tracking
model UserSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String    @unique
  userId          String?   @db.Uuid
  startTime       DateTime  @default(now()) @db.Timestamp(6)
  endTime         DateTime?
  duration        Int? // milliseconds
  pageCount       Int       @default(0)
  clickCount      Int       @default(0)
  converted       Boolean   @default(false)
  conversionType  String? // signup, application, payment, etc
  conversionValue Decimal?  @db.Decimal(12, 2)
  landingPage     String?
  exitPage        String?
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  device          String?
  browser         String?
  os              String?
  country         String?
  region          String?
  city            String?

  @@index([sessionId])
  @@index([userId])
  @@index([startTime])
  @@index([converted])
}

// FormInteraction - Form field tracking for optimization
model FormInteraction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String
  userId    String?  @db.Uuid
  formId    String
  formName  String?
  fieldName String?
  action    String // focus, blur, change, submit, abandon
  timeSpent Int? // milliseconds on field
  completed Boolean  @default(false)
  timestamp DateTime @default(now()) @db.Timestamp(6)

  @@index([sessionId])
  @@index([formId])
  @@index([completed])
}

// ConversionFunnel - Funnel step tracking
model ConversionFunnel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String
  userId         String?  @db.Uuid
  step           String // visit, view_listing, start_application, submit_application, payment
  stepOrder      Int
  completed      Boolean  @default(false)
  timeToComplete Int? // milliseconds from previous step
  metadata       Json?    @db.Json
  timestamp      DateTime @default(now()) @db.Timestamp(6)

  @@index([sessionId])
  @@index([step])
  @@index([completed])
}

// ============= EVENT SYSTEM MODELS =============
// These models replace cron jobs with an event-driven system

// SystemEvent - Stores all system events for audit trail and recovery
model SystemEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String // Event type (e.g., 'lease.tenant_signed')
  payload     Json      @db.Json // Event data
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)

  @@index([type])
  @@index([processed])
  @@index([createdAt])
}

// ScheduledJob - Database-backed job queue that replaces cron jobs
model ScheduledJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String // Job type (e.g., 'send_reminder')
  payload      Json      @db.Json // Job data
  scheduledFor DateTime  @db.Timestamp(6) // When to run the job
  priority     Int       @default(0) // Higher = more important
  status       String    @default("pending") // pending, processing, completed, failed
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  lastError    String?
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  completedAt  DateTime? @db.Timestamp(6)

  @@index([type])
  @@index([status])
  @@index([scheduledFor])
  @@index([priority])
}

// ============= CONTRACTOR BUSINESS OPERATING SYSTEM =============
// Full business management system for contractors (Professional & Business tiers)

// ContractorJob - Complete job/project management (replaces work orders for contractor's own business)
model ContractorJob {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  customerId   String? @db.Uuid // Link to ContractorCustomer
  leadId       String? @db.Uuid // Link to ContractorLead if converted

  // Job identification
  jobNumber   String  @unique // Auto-generated: JOB-2024-0001
  title       String
  description String?
  jobType     String? // Kitchen Remodel, Bathroom, Deck, etc.

  // Status tracking
  status String @default("quoted") // quoted, approved, scheduled, in_progress, on_hold, completed, invoiced, paid, canceled

  // Location
  address     String?
  city        String?
  state       String?
  zipCode     String?
  coordinates Json?   @db.Json // { lat, lng }

  // Financial
  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)
  laborCost     Decimal? @db.Decimal(12, 2)
  materialCost  Decimal? @db.Decimal(12, 2)
  profitMargin  Decimal? @db.Decimal(5, 2) // Percentage

  // Timeline
  estimatedStartDate DateTime? @db.Timestamp(6)
  estimatedEndDate   DateTime? @db.Timestamp(6)
  actualStartDate    DateTime? @db.Timestamp(6)
  actualEndDate      DateTime? @db.Timestamp(6)
  estimatedHours     Int?
  actualHours        Int?

  // Team assignment
  assignedEmployeeIds String[] @default([]) // Array of employee IDs
  leadTechnicianId    String?  @db.Uuid

  // Documents & Media
  photos       String[] @default([])
  documents    String[] @default([])
  beforePhotos String[] @default([])
  afterPhotos  String[] @default([])

  // Customer satisfaction
  customerRating Int? // 1-5 stars
  customerReview String?
  reviewedAt     DateTime? @db.Timestamp(6)

  // Internal notes
  notes         String?
  internalNotes String? // Private notes not visible to customer

  // Metadata
  tags     String[] @default([])
  priority String   @default("normal") // low, normal, high, urgent

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  customer   ContractorCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Relations
  escrow          JobEscrow? // One-to-one relation with escrow
  timeEntries     ContractorTimeEntry[]
  expenses        ContractorExpense[]
  changeOrders    ContractorChangeOrder[]
  jobMilestones   ContractorJobMilestone[]
  contracts       ContractorContract[]
  jobNotes        ContractorJobNote[]
  incidentReports ContractorIncidentReport[]
  inventoryUsage  ContractorInventoryUsage[]
  materials       ContractorJobMaterial[]
  truckLoads      ContractorTruckLoad[]

  // New Feature Relations
  jobPhotos                ContractorJobPhoto[]
  purchaseOrders           ContractorPurchaseOrder[]
  subcontractorAssignments ContractorSubcontractorAssignment[]
  warranties               ContractorWarranty[]
  safetyCompletions        ContractorSafetyChecklistCompletion[]

  // Scheduling
  shifts ContractorShift[]

  // Documents
  uploadedDocuments ContractorDocument[] @relation("uploadedDocuments")

  @@index([contractorId])
  @@index([customerId])
  @@index([status])
  @@index([jobNumber])
}

// ContractorShift - Scheduled shifts for contractor employees.
// Mirrors the landlord-side `Shift` model but keyed off ContractorProfile +
// ContractorEmployee, with an optional link to a ContractorJob for jobs that
// the shift is targeted at.
model ContractorShift {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String   @db.Uuid
  employeeId   String   @db.Uuid
  jobId        String?  @db.Uuid
  date         DateTime @db.Date
  startTime    String // "09:00" 24h format
  endTime      String // "17:00" 24h format
  notes        String?
  status       String   @default("scheduled") // scheduled, completed, missed, cancelled
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt

  contractor ContractorProfile  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  employee   ContractorEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  job        ContractorJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([employeeId])
  @@index([date])
  @@index([jobId])
}

// ContractorEmployee - Team member management
model ContractorEmployee {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  userId       String? @db.Uuid // Link to User if they have an account
  roleId       String? @db.Uuid // Link to ContractorRole for RBAC

  // Basic info
  firstName String
  lastName  String
  email     String?
  phone     String?
  photo     String?

  // Employment
  role              String // Lead Technician, Helper, Subcontractor, Admin (legacy - use roleId)
  employeeType      String    @default("w2") // w2, 1099, subcontractor
  status            String    @default("active") // active, inactive, terminated, invited
  hireDate          DateTime  @db.Timestamp(6)
  terminationDate   DateTime? @db.Timestamp(6)
  terminationReason String? // voluntary, involuntary, contract_end, layoff

  // Invite / Onboarding
  inviteToken  String?   @unique // UUID token sent via email for account linking
  inviteExpiry DateTime? @db.Timestamp(6)
  invitedAt    DateTime? @db.Timestamp(6)
  onboardedAt  DateTime? @db.Timestamp(6) // when they accepted invite & linked account

  // Compensation
  payRate     Decimal @db.Decimal(10, 2)
  payType     String  @default("hourly") // hourly, salary, per_job
  paySchedule String? // weekly, biweekly, monthly

  // Skills & Certifications
  skills         String[]  @default([])
  certifications String[]  @default([])
  licenseNumber  String?
  licenseExpiry  DateTime? @db.Timestamp(6)

  // Performance tracking
  totalJobsCompleted Int     @default(0)
  avgRating          Decimal @default(0) @db.Decimal(3, 2)
  onTimeRate         Decimal @default(0) @db.Decimal(5, 2)

  // Access & Permissions (legacy - use roleId)
  canViewFinancials  Boolean @default(false)
  canManageJobs      Boolean @default(false)
  canManageCustomers Boolean @default(false)

  // Custom permissions (override role permissions)
  customPermissions Json? @db.Json

  // Documents
  documents String[] @default([]) // W4, I9, licenses, etc.

  // Emergency contact
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  assignedRole ContractorRole?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Relations
  timeEntries            ContractorTimeEntry[]
  assignments            ContractorJobAssignment[]
  communications         ContractorCommunication[]
  timeOffRequests        ContractorTimeOff[]
  employeeCertifications ContractorCertification[]
  incidentReports        ContractorIncidentReport[]
  equipmentAssignments   ContractorEquipment[]          @relation("EquipmentAssignments")
  assignedTrucks         ContractorTruck[]
  truckLoadsPerformed    ContractorTruckLoad[]          @relation("TruckLoadEmployee")
  inventoryReceived      ContractorInventoryReceiving[] @relation("InventoryReceivedBy")
  truckInventoryLoaded   ContractorTruckInventory[]     @relation("TruckInventoryLoadedBy")
  paychecks              ContractorPaycheck[]
  shifts                 ContractorShift[]

  @@index([contractorId])
  @@index([roleId])
  @@index([status])
  @@index([email])
}

// ContractorTimeEntry - Time tracking for jobs and employees
model ContractorTimeEntry {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  employeeId   String? @db.Uuid
  jobId        String? @db.Uuid

  // Time tracking
  clockIn  DateTime  @db.Timestamp(6)
  clockOut DateTime? @db.Timestamp(6)
  duration Int? // minutes (calculated on clock out)

  // Location tracking (GPS)
  clockInLocation  Json? @db.Json // { lat, lng, address }
  clockOutLocation Json? @db.Json

  // Break time
  breakMinutes Int @default(0)

  // Billing
  billableHours Decimal? @db.Decimal(5, 2)
  hourlyRate    Decimal? @db.Decimal(10, 2)
  totalAmount   Decimal? @db.Decimal(10, 2)

  // Notes
  notes String?

  // Approval
  status     String    @default("pending") // pending, approved, rejected
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  employee   ContractorEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  job        ContractorJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([employeeId])
  @@index([jobId])
  @@index([clockIn])
  @@index([status])
}

// ContractorExpense - Expense tracking for jobs
model ContractorExpense {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String  @db.Uuid
  jobId        String? @db.Uuid

  // Expense details
  category    String // Materials, Tools, Fuel, Permits, Subcontractor, Other
  description String
  amount      Decimal @db.Decimal(12, 2)
  vendor      String?

  // Date
  expenseDate DateTime @db.Timestamp(6)

  // Receipt
  receiptUrl     String?
  receiptScanned Boolean @default(false)

  // Billing
  billable Boolean @default(true)
  billed   Boolean @default(false)

  // Tax
  taxDeductible Boolean @default(true)

  // Payment
  paymentMethod String? // cash, credit_card, check, etc.
  paidBy        String? // company, employee (for reimbursement)

  // Approval
  status     String    @default("pending") // pending, approved, rejected
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamp(6)

  // QuickBooks sync
  qbPurchaseId String? // QB Purchase ID once pushed

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  job        ContractorJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([jobId])
  @@index([category])
  @@index([expenseDate])
}

// ContractorJobAssignment - Assign employees to jobs
model ContractorJobAssignment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid
  jobId        String @db.Uuid
  employeeId   String @db.Uuid

  // Assignment details
  role      String    @default("technician") // lead, technician, helper
  isLead    Boolean   @default(false)
  startDate DateTime  @db.Timestamp(6)
  endDate   DateTime? @db.Timestamp(6)

  // Status
  status String @default("assigned") // assigned, active, completed, removed

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  employee   ContractorEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([jobId, employeeId])
  @@index([contractorId])
  @@index([jobId])
  @@index([employeeId])
}

// ContractorChangeOrder - Track changes to job scope/price
model ContractorChangeOrder {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @db.Uuid
  jobId        String @db.Uuid

  // Change details
  title       String
  description String
  reason      String?

  // Financial impact
  additionalCost  Decimal @db.Decimal(12, 2)
  additionalHours Int?

  // Approval
  status       String    @default("pending") // pending, approved, rejected
  approvedBy   String? // Customer name/email
  approvedAt   DateTime? @db.Timestamp(6)
  signatureUrl String? // Digital signature

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  job        ContractorJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([jobId])
  @@index([status])
}

// ContractorJobMilestone - Track job progress milestones
model ContractorJobMilestone {
