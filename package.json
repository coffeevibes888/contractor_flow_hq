  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 server.js",
    "dev:turbo": "next dev --turbo",
    "dev:fast": "prisma generate && node --max-old-space-size=4096 server.js",
    "dev:https": "node --max-old-space-size=4096 server.js",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:stripe": "jest tests/stripe",
    "test:webhooks": "jest tests/webhooks",
    "test:marketplace": "jest tests/marketplace",
    "test:payroll": "jest tests/payroll",
    "test:rent": "jest tests/rent",
    "test:e2e": "jest tests/e2e",
    "test:all": "jest --coverage",
    "email": "cp .env ./node_modules/react-email && email dev --dir email --port 3001",
