    "seed": "ts-node db/seed-property-management.ts",
    "seed:accounts": "tsx db/seed-accounts.ts",
    "seed:marketplace": "npx tsx db/seed-marketplace-dummy-data.ts",
    "cleanup:marketplace": "npx tsx scripts/cleanup-marketplace-dummy-data.ts",
    "stats:marketplace": "npx tsx scripts/marketplace-stats.ts",
    "clean": "rm -rf .next && rm -rf node_modules/.cache"
